# ==========================================
# 1. CORE SYSTEM CONFIGURATION
# ==========================================
# Environment (development, production)
NODE_ENV=production
# API Port
PORT=8000
# Logging verbosity (debug, info, warn, error)
LOG_LEVEL=info

# ==========================================
# 2. SECURITY & AUTHENTICATION
# ==========================================
# Public repo note:
# these values are placeholders only; never commit your real .env

# Global Secret Key (CRITICAL: Change this in production!)
SECRET_KEY=super-secret-global-key-change-me
# CORS: Domains allowed to access the API (comma-separated or *)
ALLOWED_ORIGINS=*
# JWT lifetime used by the backend
JWT_EXPIRES_IN=1d

# Bcrypt Salt Rounds (Higher is slower but more secure)
BCRYPT_ROUNDS=10

# ==========================================
# 3. ADMIN BOOTSTRAP
# ==========================================
# Admin User (created automatically on startup if missing)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_in_prod
# ADMIN_DOMAIN=example.com  # Optional: Restrict admin email to a specific domain

# ==========================================
# 4. DATABASE CONNECTIONS
# ==========================================
# MongoDB
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=example
MONGO_HOST=mongo
MONGO_PORT=27017
MONGO_DB_NAME=rag_db

# Redis (Caching & Queues)
REDIS_PASSWORD=redis_password
REDIS_HOST=redis
REDIS_PORT=6379

# Qdrant (Vector Database)
QDRANT_API_KEY=qdrant_api_key_secret
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=documents
QDRANT_TELEMETRY_DISABLED=true
QDRANT_ALLOW_RECOVERY_MODE=true

# ==========================================
# 5. AI INTELLIGENCE & OPTIMIZATION
# ==========================================
# Embeddings Model (HuggingFace) - Multilingual recommended
EMBEDDING_MODEL=intfloat/multilingual-e5-large
EMBEDDING_SIZE=1024

# Sparse Model (Splade/BM42) - Multilingual recommended: Qdrant/bm42-all-minilm-l6-v2-attentions
SPARSE_EMBEDDING_MODEL=Qdrant/bm42-all-minilm-l6-v2-attentions

# Reranker Model (Cross-Encoder) - Multilingual recommended
# Options: cross-encoder/mmarco-mMiniLM-v2-L12-H384-v1 (Balanced), BAAI/bge-reranker-v2-m3 (State-of-the-art)
RERANKER_MODEL=cross-encoder/mmarco-mMiniLM-v2-L12-H384-v1

# System Optimization (CPU threads for localized models)
OMP_NUM_THREADS=1
MKL_NUM_THREADS=1

# ==========================================
# 6. STORAGE & INGESTION
# ==========================================
# Host path used by docker-compose.yml in Swarm mode.
# Must exist on every node and point to the same NFS export for uploads.
UPLOADS_HOST_PATH=/srv/rag/uploads

# Swarm placement for workers.
# Replace these placeholders with your real node hostnames before deploying in Swarm.
INGESTION_NODE_HOSTNAME=swarm-worker-ingestion
SEARCH_NODE_HOSTNAME=swarm-worker-search

# Host path used by docker-compose.yml.local in local mode.
# Relative path is valid here because it runs on a single machine.
LOCAL_UPLOADS_PATH=./secure/uploads

# Local storage directory for uploaded files
DOCS_DIR=/app/uploads

# Upload limit in MB
MAX_FILE_SIZE_MB=50

# Default chunking parameters
DOC_CHUNK_SIZE=1536
DOC_CHUNK_OVERLAP=256
PST_CHUNK_SIZE=1024
PST_CHUNK_OVERLAP=128

# Default search behavior
SEARCH_LIMIT=10
SEARCH_THRESHOLD=0.6

# Number of concurrent ingestion workers (Processes per container)
# Recommended: 2-4 for limited resources, 8-16 for powerful servers
INGESTION_CONCURRENCY=5

# ==========================================
# 7. PUBLIC URLS
# ==========================================
# Public frontend URL (used in password reset links and emails)
FRONTEND_URL=http://localhost

# Frontend Container/Internal URL (Used by frontend build)
VITE_API_URL=/api/v1

# ==========================================
# 8. APP BRANDING
# ==========================================
APP_NAME=RAG Platform
THEME_COLOR=#2563eb
APP_LOGO_URL=https://cdn-icons-png.flaticon.com/512/188/188109.png

# ==========================================
# 9. EMAIL DELIVERY
# ==========================================
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
EMAIL_FROM=noreply@example.com

# ==========================================
# 10. IMAP INGESTION
# ==========================================
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_POLL_INTERVAL=300
IGNORED_EMAIL_SENDERS=
